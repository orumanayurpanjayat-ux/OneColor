<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/preboot_page">
    <dev.oneuiproject.oneui.layout.ToolbarLayout android:id="@+id/guest_modules_toolbar"
        android:layout_width="match_parent" android:layout_height="match_parent"
        app:handleInsets="false" app:expandable="false" app:expanded="false" app:mainRoundedCorners="top" app:showNavButtonAsBack="true">
        <androidx.core.widget.NestedScrollView android:id="@+id/guest_modules_scroll"
            android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingHorizontal="16dp"
                android:paddingTop="12dp" android:paddingBottom="24dp">

                <dev.oneuiproject.oneui.widget.RoundedLinearLayout
                    style="@style/OneOS.Card"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="@string/guest_modules_intro_title"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="18sp" android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/guest_modules_intro_summary"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="14sp" android:lineSpacingMultiplier="1.12" />
                </dev.oneuiproject.oneui.widget.RoundedLinearLayout>

                <LinearLayout android:id="@+id/guest_modules_list"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:accessibilityLiveRegion="polite" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </dev.oneuiproject.oneui.layout.ToolbarLayout>
    <FrameLayout android:id="@+id/guest_modules_footer" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_gravity="bottom" android:paddingVertical="12dp">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/guest_modules_import"
            style="@style/OneUI.ContainedButton" android:theme="@style/OneUI.ContainedPrimaryColorButtonTheme"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp" android:layout_gravity="center_horizontal"
            android:text="@string/guest_modules_import" android:textSize="16sp" android:textStyle="bold"
            android:minHeight="56dp" android:paddingHorizontal="20dp" android:paddingVertical="14dp"
            android:backgroundTint="@color/preboot_primary"
            android:drawableStart="@drawable/ic_oui_download" android:drawablePadding="10dp" />
    </FrameLayout>
</FrameLayout>
